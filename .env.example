# Copiez ce fichier en « .env.local » (en local) ou saisissez ces variables
# chez votre hébergeur (Vercel : Settings → Environment Variables).

# Adresse publique du site.
NEXT_PUBLIC_SITE_URL=https://www.atlasafricagroup.com

# Envoi du formulaire de contact avec Resend (https://resend.com).
# 1. Créez un compte Resend et vérifiez le domaine atlasafricagroup.com.
# 2. Créez une clé d'API et collez-la ci-dessous.
RESEND_API_KEY=
# Expéditeur : une adresse du domaine vérifié chez Resend.
CONTACT_FROM_EMAIL="ATLAS AFRICA GROUP <site@atlasafricagroup.com>"
# Destinataire des demandes (facultatif : par défaut, l'e-mail du site).
CONTACT_TO_EMAIL=info@atlasafricagroup.com
